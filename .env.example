# InterSystems IRIS connection settings.
# Copy to `.env` and fill in your instance's values.

IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS

# OpenAI settings for LLM-assisted semantic resource selection.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-5.4-nano).
OPENAI_MODEL=gpt-5.4-nano
